# =============================================================================
# RECOVERY SUMATERA - ENVIRONMENT VARIABLES
# =============================================================================

# Groq API Key (Dapatkan gratis di https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Upstash Vector Database (Dapatkan di Upstash Console / Vercel Marketplace)
UPSTASH_VECTOR_REST_URL=https://your-database-name-region.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# (Opsional) OpenAI API Key jika ingin menggunakan model embedding kustom
OPENAI_API_KEY=sk-your_openai_api_key_here
